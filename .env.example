# =============================================================================
# NEUIToolkit Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Primary provider: openai, anthropic, google, ollama
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=4096
OPENAI_COST_PER_1K=0.03

# Anthropic (Claude) Configuration
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_TEMPERATURE=0.2
# ANTHROPIC_MAX_TOKENS=4096
# ANTHROPIC_COST_PER_1K=0.015

# Google (Gemini) Configuration
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_MODEL=gemini-1.5-pro
# GOOGLE_TEMPERATURE=0.2
# GOOGLE_MAX_TOKENS=4096
# GOOGLE_COST_PER_1K=0.0125

# Ollama (Local Models) Configuration
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
# OLLAMA_TEMPERATURE=0.2
# OLLAMA_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# Quality Assurance Configuration
# -----------------------------------------------------------------------------
# Enable/disable quality assurance layer
ENABLE_QA=true

# Minimum confidence threshold (0.0 to 1.0)
QA_MIN_CONFIDENCE=0.5

# Strict mode: reject low-quality extractions
QA_STRICT_MODE=false

# -----------------------------------------------------------------------------
# Neo4j Graph Database Configuration
# -----------------------------------------------------------------------------
# Enable/disable Neo4j integration
ENABLE_NEO4J=false

# Neo4j connection details
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your_neo4j_password_here
# NEO4J_DATABASE=neo4j

# -----------------------------------------------------------------------------
# Prompt Configuration
# -----------------------------------------------------------------------------
# Domain-specific prompts: general, education, medical, legal, scientific, business
PROMPT_DOMAIN=general

# Prompt version to use (for A/B testing and versioning)
PROMPT_VERSION=1.0.0